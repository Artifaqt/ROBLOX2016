		<Item class="Script" referent="RBX28">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<ProtectedString name="Source">test = Game:GetService(&quot;TestService&quot;)

terrain = game.Workspace.Terrain
GetWaterCell = terrain.GetWaterCell
GetSolidCell = terrain.GetCell

function countCells(minX, maxX, minY, maxY, minZ, maxZ)
&#9;local waterCount = 0
&#9;local solidCount = 0
&#9;local waterWedgeCount = 0
&#9;for y=minY,maxY do
&#9;&#9;for z=minZ,maxZ do
&#9;&#9;&#9;for x =minX,maxX do
&#9;&#9;&#9;&#9;local hasWater, force, direction = GetWaterCell(terrain, x, y, z)
&#9;&#9;&#9;&#9;if hasWater then waterCount = waterCount + 1 end
&#9;&#9;&#9;&#9;local material, block, orientation = GetSolidCell(terrain, x, y, z)
&#9;&#9;&#9;&#9;if material ~= Enum.CellMaterial.Empty then solidCount = solidCount + 1 end
&#9;&#9;&#9;&#9;if material ~= Enum.CellMaterial.Water and hasWater then waterWedgeCount = waterWedgeCount + 1 end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return waterCount, solidCount, waterWedgeCount
end

waterCount, solidCount, waterWedgeCount = countCells(-256, -224, 0, 62, -256, -224)

test:Check(waterCount == 16537, string.format(&quot;Water Count: %d&quot;, waterCount))
test:Check(solidCount == 43023, string.format(&quot;Solid Count: %d&quot;, solidCount))
test:Check(waterWedgeCount == 1170, string.format(&quot;Water-Wedge Count: %d&quot;, waterWedgeCount))

waterCount, solidCount, waterWedgeCount = countCells(224, 256, 0, 62, 224, 256)

test:Check(waterCount == 12814, string.format(&quot;Water Count: %d&quot;, waterCount))
test:Check(solidCount == 37203, string.format(&quot;Solid Count: %d&quot;, solidCount))
test:Check(waterWedgeCount == 1413, string.format(&quot;Water-Wedge Count: %d&quot;, waterWedgeCount))

test:Done()
</ProtectedString>
			</Properties>
		</Item>
	</Item>
</namehere>