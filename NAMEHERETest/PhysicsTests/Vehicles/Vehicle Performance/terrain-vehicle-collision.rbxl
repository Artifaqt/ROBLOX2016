					<CoordinateFrame name="CFrame">
						<X>-332.801819</X>
						<Y>27.0018501</Y>
						<Z>-336.487854</Z>
						<R00>-0.707070649</R00>
						<R01>-2.12029949e-009</R01>
						<R02>0.707130969</R02>
						<R10>1.24793615e-008</R10>
