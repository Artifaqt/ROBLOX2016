				<Item class="Script" referent="RBX3270">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">UFOScript</string>
						<ProtectedString name="Source">local seat = script.Parent
local vChar = nil
local vPlayer = nil
local driveTool = nil

local rayBeam = seat.Parent.RayBeam

function waitForChild(parent, child)
&#9;while not parent:FindFirstChild(child) do parent.ChildAdded:wait() end
end

-- fix rayBeam to be right size and transparent
waitForChild(seat.Parent, &quot;btm&quot;)
waitForChild(seat.Parent.btm, &quot;rayWeld&quot;)

local rayWeld = seat.Parent.btm.rayWeld
rayWeld.Parent = nil
rayBeam.Size = Vector3.new(2, 53.2, 2)
rayWeld.Parent = seat.Parent.btm
rayWeld.C0 = rayWeld.C0 - rayWeld.C0.p + Vector3.new(-4, 0.5, 4)

rayBeam.Transparency = 1

function bindToNewPlayer()
 vPlayer = game.Players:GetPlayerFromCharacter(vChar)

 if vPlayer then
  -- remove motion damper script
  local motionDamper = seat.Parent.btm:FindFirstChild(&quot;MotionDamper&quot;)
  if motionDamper then motionDamper:Remove() end

  -- copy over UFO drive tool
  --driveTool = script.UFODriveTool:Clone()
  driveToolClone = script.UFODriveTool:Clone()
  driveTool = script.UFODriveTool

  local newHandle = Instance.new(&quot;Part&quot;)
  newHandle.Size = Vector3.new(.1, .1, .1)
  newHandle.Transparency = 1
  newHandle.Name = &quot;Handle&quot;
  newHandle.Parent = driveTool
  driveTool.UFOPointer.Value = seat.Parent

  -- remove existing tools
  local vChildren = vChar:GetChildren()
  for i = 1, #vChildren do
   if vChildren[i]:IsA(&quot;Tool&quot;) then
    vChildren[i].Parent = vPlayer.Backpack
   end
  end

  -- give &apos;em the saucer tool!
  driveToolClone.Parent = script
  driveTool.Parent = vChar
 end
end

function checkAddChild(newChild)
&#9;if newChild.Name == &quot;SeatWeld&quot; then
&#9;&#9;if newChild.Part0 == seat then vChar = newChild.Part1.Parent
&#9;&#9;else vChar = newChild.Part0.Parent end

&#9;&#9;bindToNewPlayer()
&#9;end
end

function checkRemoveChild(oldChild)
&#9;if oldChild.Name == &quot;SeatWeld&quot; then
&#9;&#9;vChar = nil
&#9;&#9;vPlayer = nil
&#9;&#9;driveTool:Remove()
&#9;&#9;driveTool = nil

&#9;&#9;local newMotionDamper = script.Parent.Parent.btm:FindFirstChild(&quot;MotionDamper&quot;)
&#9;&#9;if newMotionDamper == nil then
&#9;&#9;&#9;newMotionDamper = script.UFODriveTool.UFODriveScript.MotionDamper:Clone()
&#9;&#9;&#9;newMotionDamper.Parent = script.Parent.Parent.btm
&#9;&#9;&#9;newMotionDamper.Disabled = false
&#9;&#9;end

&#9;&#9;script.Parent.Parent.btm.UFOPosition.maxForce = Vector3.new(0, 0, 0)
&#9;&#9;script.Parent.Parent.btm.UFOGyro.maxTorque = Vector3.new(0, 0, 0)

&#9;&#9;rayBeam.Transparency = 1
&#9;end
end


seat.ChildAdded:connect(checkAddChild)
seat.ChildRemoved:connect(checkRemoveChild)</ProtectedString>
					</Properties>
					<Item class="Tool" referent="RBX3271">
						<Properties>
							<bool name="CanBeDropped">true</bool>
							<bool name="Enabled">true</bool>
							<CoordinateFrame name="Grip">
								<X>0</X>
								<Y>0</Y>
								<Z>0</Z>
								<R00>1</R00>
								<R01>0</R01>
								<R02>0</R02>
								<R10>0</R10>
								<R11>1</R11>
								<R12>0</R12>
								<R20>0</R20>
								<R21>0</R21>
								<R22>1</R22>
							</CoordinateFrame>
							<string name="Name">UFODriveTool</string>
							<Content name="TextureId"><null></null></Content>
							<string name="ToolTip"></string>
						</Properties>
						<Item class="LocalScript" referent="RBX3272">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">UFODriveScript</string>
								<ProtectedString name="Source">local maxVelocity = 40
local minVelocity = -40

local maxSideVelocity = 40
local minSideVelocity = -40

local acceleration = 1.5
local deceleration = 1.5
local autoDeceleration = .25

local sideAcceleration = 1.5
local sideDeceleration = 1.5
local autoSideDeceleration = .25

local liftOffSpeed = .25
local liftSpeed = .5
local lowerSpeed = .5

local maxHeight = 500
local minHeight = 0

local r = game:GetService(&quot;RunService&quot;)

local Tool = script.Parent
local Mouse = nil
local ufo = nil
local ufoVel = nil
local ufoGyr = nil
local ufoPos = nil

local camera = nil

local forward = false
local left = false
local right = false
local backward = false
local lift = false
local lower = false
-- duplicates for arrow keys
local forwardArrow = false
local leftArrow = false
local rightArrow = false
local backwardArrow = false

local velocity = Vector3.new(0, 0, 0)
local sideVelocity = 0

local motionThread = nil

function keyDown(key)
&#9;key = key:lower()
&#9;if key == &quot;w&quot; then
&#9;&#9;forward = true
&#9;elseif key == &quot;s&quot; then
&#9;&#9;backward = true
&#9;elseif key == &quot;a&quot; then 
&#9;&#9;left = true
&#9;elseif key == &quot;d&quot; then
&#9;&#9;right = true
&#9;elseif key == &quot;q&quot; then
&#9;&#9;lift = true
&#9;elseif key == &quot;z&quot; then
&#9;&#9;lower = true
&#9;elseif key == &quot;&#17;&quot; then
&#9;&#9;forwardArrow = true
&#9;elseif key == &quot;&#20;&quot; then
&#9;&#9;leftArrow = true
&#9;elseif key == &quot;&#18;&quot; then
&#9;&#9;backwardArrow = true
&#9;elseif key == &quot;&#19;&quot; then
&#9;&#9;rightArrow = true
&#9;end
end

function keyUp(key)
&#9;key = key:lower()
&#9;if key == &quot;w&quot; then
&#9;&#9;forward = false
&#9;elseif key == &quot;s&quot; then
&#9;&#9;backward = false
&#9;elseif key == &quot;a&quot; then 
&#9;&#9;left = false
&#9;elseif key == &quot;d&quot; then
&#9;&#9;right = false
&#9;elseif key == &quot;q&quot; then
&#9;&#9;lift = false
&#9;elseif key == &quot;z&quot; then
&#9;&#9;lower = false
&#9;elseif key == &quot;&#17;&quot; then
&#9;&#9;forwardArrow = false
&#9;elseif key == &quot;&#20;&quot; then
&#9;&#9;leftArrow = false
&#9;elseif key == &quot;&#18;&quot; then
&#9;&#9;backwardArrow = false
&#9;elseif key == &quot;&#19;&quot; then
&#9;&#9;rightArrow = false
&#9;end
end

function laserOn()
&#9;if ufo then
&#9;&#9;ufo.RayBeam.Transparency = 0.8
&#9;end
end

function laserOff()
&#9;if ufo then
&#9;&#9;ufo.RayBeam.Transparency = 1
&#9;end
end

function manageMotionStep(forceLift)
&#9;--print(&quot;MotionStep&quot;)
&#9;local goForward = forward or forwardArrow
&#9;local goLeft = left or leftArrow
&#9;local goRight = right or rightArrow
&#9;local goBackward = backward or backwardArrow

&#9;local cameraForwards = -camera.CoordinateFrame:vectorToWorldSpace(Vector3.new(0, 0, 1))
&#9;local cameraSideways = -camera.CoordinateFrame:vectorToWorldSpace(Vector3.new(1, 0, 0))

&#9;cameraForwards = cameraForwards * Vector3.new(1, 0, 1)
&#9;cameraSideways = cameraSideways * Vector3.new(1, 0, 1)

&#9;if cameraForwards:Dot(cameraForwards) &lt; .1 or cameraSideways:Dot(cameraSideways) &lt; .1 then return end -- make sure no division by 0 errors
&#9;cameraForwards = cameraForwards.unit
&#9;cameraSideways = cameraSideways.unit

&#9;--print(&quot;A&quot;)

&#9;--ufoVel.velocity = cameraForwards * velocity + cameraSideways * sideVelocity
&#9;ufoVel.velocity = velocity
&#9;--ufoGyr.cframe = CFrame.new(Vector3.new(0, 0, 0), velocity) * CFrame.Angles(velocity:Dot(Vector3.new(0, 0, 1))*math.pi/320, 0, math.pi + velocity:Dot(Vector3.new(1, 0, 0))*math.pi/320) --CFrame.new(Vector3.new(0,0,0), cameraForwards*velocity) * CFrame.Angles(0, 0, math.pi) --* CFrame.Angles(velocity/maxVelocity * math.pi/4, 0, sideVelocity/maxSideVelocity * math.pi/4)
&#9;--ufoGyr.cframe = CFrame.new() * CFrame.Angles(velocity:Dot(Vector3.new(0, 0, 1))*math.pi/320, 0, math.pi - velocity:Dot(Vector3.new(1, 0, 0))*math.pi/320)
&#9;ufoGyr.cframe = CFrame.new() * CFrame.Angles(velocity:Dot(Vector3.new(0, 0, 1))*math.pi/320, 0, math.pi - velocity:Dot(Vector3.new(1, 0, 0))*math.pi/320)

&#9;--print(&quot;B&quot;)

&#9;if goForward and (not goBackward) and velocity:Dot(cameraForwards) &lt; maxVelocity then
&#9;&#9;velocity = velocity + acceleration * cameraForwards
&#9;elseif goBackward and (not goForward) and velocity:Dot(cameraForwards) &gt; minVelocity then
&#9;&#9;velocity = velocity - deceleration * cameraForwards
&#9;elseif (not goBackward) and (not goForward) and velocity:Dot(cameraForwards) &gt; 0 then
&#9;&#9;velocity = velocity - autoDeceleration * cameraForwards
&#9;elseif (not goBackward) and (not goForward) and velocity:Dot(cameraForwards) &lt; 0 then
&#9;&#9;velocity = velocity + autoDeceleration * cameraForwards
&#9;end

&#9;if goLeft and (not goRight) and velocity:Dot(cameraSideways) &lt; maxSideVelocity then
&#9;&#9;velocity = velocity + sideAcceleration * cameraSideways
&#9;elseif goRight and (not goLeft) and velocity:Dot(cameraSideways) &gt; minSideVelocity then
&#9;&#9;velocity = velocity - sideDeceleration * cameraSideways
&#9;elseif (not goRight) and (not goLeft) and velocity:Dot(cameraSideways) &gt; 0 then
&#9;&#9;velocity = velocity - autoSideDeceleration * cameraSideways
&#9;elseif (not goRight) and (not goLeft) and velocity:Dot(cameraSideways) &lt; 0 then
&#9;&#9;velocity = velocity + autoSideDeceleration * cameraSideways
&#9;end

&#9;if forceLift then
&#9;&#9;if ufoPos.position.Y &lt; maxHeight then
&#9;&#9;&#9;ufoPos.position = ufoPos.position + Vector3.new(0, liftOffSpeed, 0)
&#9;&#9;end
&#9;else
&#9;&#9;if lift and (not lower) and ufoPos.position.Y &lt; maxHeight then
&#9;&#9;&#9;ufoPos.position = ufoPos.position + Vector3.new(0, liftSpeed, 0)
&#9;&#9;elseif lower and (not lift) and ufoPos.position.Y &gt; minHeight then
&#9;&#9;&#9;ufoPos.position = ufoPos.position - Vector3.new(0, lowerSpeed, 0)
&#9;&#9;end
&#9;end
end

local keepMotionThreadAlive = true
function motionManager()
&#9;print(&quot;Starting Motion Manager&quot;)
&#9;
&#9;-- initially, we force UFO to rise
&#9;local startTime = r.Stepped:wait()
&#9;while keepMotionThreadAlive and (r.Stepped:wait() - startTime &lt; 5) do
&#9;&#9;manageMotionStep(true)
&#9;end

&#9;while keepMotionThreadAlive or velocity:Dot(velocity) &gt; .5 do
&#9;&#9;manageMotionStep()
&#9;&#9;wait()
&#9;end
&#9;print(&quot;Ending Motion Manager&quot;)
end

function liftOff()
&#9;-- btm part actually &quot;drives&quot; the UFO
&#9;print(&quot;WE HAVE LIFT OFF!&quot;)

&#9;ufoVel = ufo.btm.UFOVelocity
&#9;ufoGyr = ufo.btm.UFOGyro
&#9;ufoPos = ufo.btm.UFOPosition

&#9;local motionDamper = ufo.btm:FindFirstChild(&quot;MotionDamper&quot;)
&#9;if motionDamper then motionDamper:Remove() end

&#9;ufoPos.position = ufo.btm.Position
&#9;ufoPos.maxForce = Vector3.new(0, 500000, 0)

&#9;ufoGyr.maxTorque = Vector3.new(100000, 100000, 100000)

&#9;velocity = Vector3.new(0, 0, 0)

&#9;keepMotionThreadAlive = true
&#9;motionThread = coroutine.create(motionManager)
&#9;coroutine.resume(motionThread)
end

function onEquipped(mouse)
&#9;ufo = script.Parent.UFOPointer.Value
&#9;camera = game.Workspace.CurrentCamera

&#9;if mouse and ufo and camera then 
&#9;&#9;Mouse = mouse 
&#9;&#9;Mouse.KeyDown:connect(keyDown)
&#9;&#9;Mouse.KeyUp:connect(keyUp)

&#9;&#9;Mouse.Button1Down:connect(laserOn)
&#9;&#9;Mouse.Button1Up:connect(laserOff)

&#9;&#9;liftOff()
&#9;end
end

function onUnequipped()
&#9;keepMotionThreadAlive = false
&#9;
&#9;forward = false
&#9;left = false
&#9;right = false
&#9;backward = false
&#9;lift = false
&#9;lower = false
&#9;forwardArrow = false
&#9;backwardArrow = false
&#9;leftArrow = false
&#9;rightArrow = false


&#9;local newMotionDamper = script.MotionDamper:Clone()
&#9;if ufo then 
&#9;&#9;ufoPos.maxForce = Vector3.new(0, 0, 0)
&#9;&#9;ufoGyr.maxTorque = Vector3.new(0, 0, 0)

&#9;&#9;newMotionDamper.Parent = ufo.btm
&#9;&#9;newMotionDamper.Disabled = false

&#9;&#9;ufo.RayBeam.Transparency = 1

&#9;&#9;-- make them stand up when tool is unequipped
&#9;&#9;local ufoSeat = ufo:FindFirstChild(&quot;VehicleSeat&quot;)
&#9;&#9;if ufoSeat then
&#9;&#9;&#9;local ufoWeld = ufoSeat:FindFirstChild(&quot;SeatWeld&quot;)
&#9;&#9;&#9;ufoWeld:Remove()
&#9;&#9;end
&#9;end

&#9;-- remove the drive tool now
&#9;if script.Parent then script.Parent:Remove() end
end

Tool.Equipped:connect(onEquipped)
Tool.Unequipped:connect(onUnequipped)
</ProtectedString>
							</Properties>
							<Item class="Script" referent="RBX3273">
								<Properties>
									<bool name="Disabled">true</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">MotionDamper</string>
									<ProtectedString name="Source">local engine = script.Parent
local engineForce = engine.UFOVelocity

local autoDeceleration = .25

while engineForce.velocity:Dot(engineForce.velocity) &gt; .05 do
&#9;engineForce.velocity = engineForce.velocity - engineForce.velocity.unit * autoDeceleration
&#9;wait()
end
</ProtectedString>
