		<Item class="Script" referent="RBX6192">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<ProtectedString name="Source">local NUMBER_OF_PHYSICS_SECONDS_TO_RUN_FOR = 20

local r = game:GetService(&quot;RunService&quot;)
-- give it .1 physics seconds (any non-zero amount really) to warm up
local startTime = r.Stepped:wait()
while (r.Stepped:wait() - startTime &lt; .1) do end

-- now the part we care about:
local startTick = tick()
startTime = r.Stepped:wait()
while (r.Stepped:wait() - startTime &lt; NUMBER_OF_PHYSICS_SECONDS_TO_RUN_FOR) do end

local endTick = tick()
script.Parent:Warn(false, &quot;took &quot; .. tostring(endTick - startTick) .. &quot; seconds to run for &quot; .. tostring(NUMBER_OF_PHYSICS_SECONDS_TO_RUN_FOR) .. &quot; physics seconds.&quot;)
script.Parent:Check(true, &quot;an error occurred during the terrain-vehicle collision performance test&quot;)
</ProtectedString>
			</Properties>
		</Item>
	</Item>
</namehere>