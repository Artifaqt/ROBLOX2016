			<Item class="Script" referent="RBX767">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">StamperFloorRemover</string>
					<ProtectedString name="Source">function waitForChild(instance, name)
&#9;while not instance:FindFirstChild(name) do
&#9;&#9;instance.ChildAdded:wait()
&#9;end
end

local model = script.Parent
waitForChild(model, &quot;StamperFloor&quot;)

model.StamperFloor:Remove()

script:Remove()</ProtectedString>
				</Properties>
			</Item>
		</Item>
