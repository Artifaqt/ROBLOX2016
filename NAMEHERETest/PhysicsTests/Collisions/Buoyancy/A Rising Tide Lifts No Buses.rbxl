		<Item class="Script" referent="RBX1121">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">TheFlood</string>
				<ProtectedString name="Source">local count = 0

local BusPos = Workspace.Bus.VehicleSeat.Position
local TruckPos = Workspace.Truck.VehicleSeat.Position

for y = 0, 20 do
&#9;for x = -256,256 do
&#9;&#9;for z = -256,256 do
&#9;&#9;&#9;if game.Workspace.Terrain:GetCell(x,y,z) == Enum.CellMaterial.Empty then
&#9;&#9;&#9;&#9;game.Workspace.Terrain:SetWaterCell(x,y,z, Enum.WaterForce.None, Enum.WaterDirection.X)
&#9;&#9;&#9;end

&#9;&#9;&#9;count = count + 1
&#9;
&#9;&#9;&#9;if (count &gt; script.CellsPerSecond.Value / 30) then
&#9;&#9;&#9;&#9;count = 0
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

-- make sure Bus and Truck both got flotsam-ed!
local endBusPos = Workspace.Bus.VehicleSeat.Position
local endTruckPos = Workspace.Truck.VehicleSeat.Position

script.Parent:Check(endTruckPos.y &gt; TruckPos.y,
&#9;&#9;&#9;&#9;&#9;&#9;  &quot;Truck float test failed. Start Truck Pos: (&quot; ..
&#9;&#9;&#9;&#9;&#9;&#9;  TruckPos.x .. &quot;, &quot; .. TruckPos.y .. &quot;, &quot; .. TruckPos.z ..
&#9;&#9;&#9;&#9;&#9;&#9;  &quot;     End Truck Pos: (&quot; ..
&#9;&#9;&#9;&#9;&#9;&#9;  endTruckPos.x .. &quot;, &quot; .. endTruckPos.y .. &quot;, &quot; .. endTruckPos.z .. &quot;)&quot; )

script.Parent:Check(endBusPos.y &gt; BusPos.y,
&#9;&#9;&#9;&#9;&#9;&#9;  &quot;Bus float test failed. Start Bus Pos: (&quot; ..
&#9;&#9;&#9;&#9;&#9;&#9;&#9;BusPos.x .. &quot;, &quot; .. BusPos.y .. &quot;, &quot; .. BusPos.z ..
&#9;&#9;&#9;&#9;&#9;&#9;  &quot;      End Bus Pos: (&quot; ..
&#9;&#9;&#9;&#9;&#9;&#9;&#9;endBusPos.x .. &quot;, &quot; .. endBusPos.y .. &quot;, &quot; .. endBusPos.z .. &quot;)&quot; )
</ProtectedString>
			</Properties>
			<Item class="NumberValue" referent="RBX1122">
				<Properties>
					<string name="Name">CellsPerSecond</string>
					<double name="Value">100000</double>
				</Properties>
			</Item>
		</Item>
	</Item>
