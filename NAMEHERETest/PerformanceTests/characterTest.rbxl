						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GravityHammerScript</string>
						<ProtectedString name="Source">local Tool = script.Parent
local hit = nil
local out = nil
local humanoid = nil
local torso = nil
local enabled = false
local connection = nil
local reload = 5
local hammerStrength = 30
local upStrength = 1500
local children = {}
local toAffect = {}

local debris = game:GetService(&quot;Debris&quot;)

function onActivated()

&#9;if enabled then
&#9;&#9;return
&#9;end
&#9;
&#9;enabled = true

&#9;if hit ~= nil then
&#9;&#9;&#9;&#9;
&#9;&#9;makeHammerActive()
&#9;&#9;hit:Play(0.1,1,1)
&#9;&#9;connection = hit.KeyframeReached:connect(sendFlying)

&#9;&#9;wait(reload)
&#9;end

&#9;enabled = false

end

function makeHammerActive()

&#9;local part = Instance.new(&quot;Part&quot;)
&#9;part.Transparency  =  1
&#9;part.formFactor = 2
&#9;part.Size = Vector3.new(1,0.4,1)
&#9;
&#9;local fire = Instance.new(&quot;Fire&quot;)
&#9;fire.Color = Color3.new(155/255,1,206/255)
&#9;fire.SecondaryColor = Color3.new(0,1,1)
&#9;fire.Heat = -5
&#9;fire.Size = 8
&#9;fire.Parent = part

&#9;part.Parent = game.Workspace

&#9;local weld = Instance.new(&quot;Weld&quot;)
&#9;weld.Part0 = part
&#9;weld.Parent = part
&#9;weld.Part1 = Tool.Handle
&#9;weld.C0 = CFrame.new(0,-4.5,0)

&#9;debris:AddItem(part,1.5)

end

function sendFlying(stringframe)

&#9;if stringframe == &quot;sendflying&quot; then

&#9;&#9;connection:disconnect()

&#9;&#9;Tool.Handle.InitialHit:Play()
&#9;&#9;Tool.Handle.Hit:Play()

&#9;&#9;children = {}
&#9;&#9;recursiveGetChildren(game.Workspace)

&#9;&#9;for i = 1, #children do
&#9;&#9;&#9;if children[i].Anchored == false then

&#9;&#9;&#9;&#9;local dist = Vector3.new(children[i].Position.x - torso.Position.x,children[i].Position.y - torso.Position.y,children[i].Position.z - torso.Position.z)
&#9;&#9;&#9;&#9;if dist.magnitude &lt;= hammerStrength then

&#9;&#9;&#9;&#9;&#9;local bodyPos = Instance.new(&quot;BodyPosition&quot;)
&#9;&#9;&#9;&#9;&#9;local height = hammerStrength * (1 - (dist.magnitude/hammerStrength))
&#9;&#9;&#9;&#9;&#9;bodyPos.position = children[i].Position + Vector3.new(0,height,0)
&#9;&#9;&#9;&#9;&#9;bodyPos.P = children[i]:GetMass() * upStrength
&#9;&#9;&#9;&#9;&#9;bodyPos.D = bodyPos.P/2
&#9;&#9;&#9;&#9;&#9;bodyPos.maxForce = Vector3.new(bodyPos.P,bodyPos.P,bodyPos.P)
&#9;&#9;&#9;&#9;&#9;bodyPos.Parent = children[i]
&#9;&#9;&#9;&#9;&#9;debris:AddItem(bodyPos,3)

&#9;&#9;&#9;&#9;&#9;if children[i].Parent:FindFirstChild(&quot;Humanoid&quot;) == nil and children[i].Parent.Parent:FindFirstChild(&quot;Humanoid&quot;) == nil then
&#9;&#9;&#9;&#9;&#9;&#9;children[i]:BreakJoints()
&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;table.insert(toAffect,children[i])

&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;end
&#9;&#9;end


&#9;end

&#9;wait(3.1)
&#9;sendOut()
&#9;toAffect = {}

end

function sendForceFieldOut()

&#9;local fire = Instance.new(&quot;Fire&quot;)
&#9;fire.Color = Color3.new(155/255,1,206/255)
&#9;fire.SecondaryColor = Color3.new(0,1,1)
&#9;fire.Heat = -5
&#9;fire.Size = 1
&#9;fire.Parent = torso
&#9;for i = 1, 8 do
&#9;&#9;fire.Size = fire.Size + 4
&#9;&#9;wait(0.2)
&#9;end
&#9;fire:remove()
end

function sendOut()

&#9;
&#9;if #toAffect &gt; 0 then

&#9;&#9;Tool.Handle.SendOut:Play()

&#9;&#9;local co = coroutine.create(sendForceFieldOut)
&#9;&#9;coroutine.resume(co)

&#9;&#9;out:Play()
&#9;&#9;out.KeyframeReached:connect(function(string)
&#9;&#9;&#9;if string == &quot;end&quot; then
&#9;&#9;&#9;&#9;wait(0.4)
&#9;&#9;&#9;&#9;out:Stop()
&#9;&#9;&#9;end
&#9;&#9;end)

&#9;end

&#9;wait(0.3)

&#9;for i =1, #toAffect do

&#9;&#9;if toAffect[i].Parent ~= nil and toAffect[i].Parent ~= torso.Parent then

&#9;&#9;&#9;local dist = Vector3.new(torso.Position.x - toAffect[i].Position.x,torso.Position.y - toAffect[i].Position.y,torso.Position.z - toAffect[i].Position.z)

&#9;&#9;&#9;local bodyForce = Instance.new(&quot;BodyForce&quot;)
&#9;&#9;&#9;bodyForce.force = dist.unit * toAffect[i]:GetMass() * -400
&#9;&#9;&#9;bodyForce.Parent = toAffect[i]

&#9;&#9;&#9;if toAffect[i].Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil and toAffect[i].Name == &quot;Torso&quot; then
&#9;&#9;&#9;&#9;toAffect[i].Parent:FindFirstChild(&quot;Humanoid&quot;).Sit = true
&#9;&#9;&#9;end

&#9;&#9;&#9;debris:AddItem(bodyForce,1)

&#9;&#9;end

&#9;end

end

function recursiveGetChildren(parent)

&#9;local kids = parent:GetChildren()

&#9;if kids ~= nil then
&#9;&#9;for i =1, #kids do
&#9;&#9;&#9;
&#9;&#9;&#9;if kids[i].className == &quot;Part&quot; then
&#9;&#9;&#9;&#9;table.insert(children,kids[i])
&#9;&#9;&#9;end
&#9;&#9;&#9;recursiveGetChildren(kids[i])

&#9;&#9;end
&#9;end

end

function onEquipped()

&#9;humanoid = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
&#9;hit = humanoid:LoadAnimation(Tool.gravityslam)
&#9;out = humanoid:LoadAnimation(Tool.staffout)
&#9;
end

function onUnequipped()

&#9;hit:Stop()
&#9;hit:remove()
&#9;out:Stop()
&#9;out:remove()
end

Tool.Equipped:connect(onEquipped)
Tool.Unequipped:connect(onUnequipped)
Tool.Activated:connect(onActivated)</ProtectedString>
