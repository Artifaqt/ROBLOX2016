						</Properties>
					</Item>
					<Item class="Sound" referent="RBX3924">
						<Properties>
							<bool name="Looped">false</bool>
							<string name="Name">InitialHit</string>
							<float name="Pitch">1</float>
							<bool name="PlayOnRemove">false</bool>
