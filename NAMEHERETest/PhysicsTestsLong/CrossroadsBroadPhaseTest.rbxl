			<Item class="LocalScript" referent="RBX2652">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">WinGuiScript</string>
					<ProtectedString name="Source">-- Waits for parent.child to exist, then returns it
local function WaitForChild(parent, childName)
&#9;assert(parent, &quot;ERROR: WaitForChild: parent is nil&quot;)
&#9;while not parent:FindFirstChild(childName) do parent.ChildAdded:wait() end
&#9;return parent[childName]
end

local SecondsUntilRestart = WaitForChild(WaitForChild(Workspace, &apos;RoundScript&apos;), &apos;SecondsUntilRestart&apos;)
local Timer = WaitForChild(WaitForChild(script.Parent, &apos;WinFrame&apos;), &apos;CountdownTimer&apos;)



SecondsUntilRestart.Changed:connect(function(TIME_BETWEEN_ROUNDS)
&#9;if TIME_BETWEEN_ROUNDS == 0 then
&#9;&#9;Timer.Text = &quot;Waiting For Server...&quot;
&#9;else
&#9;&#9;local startTime=time()
&#9;&#9;while time()-startTime&lt;TIME_BETWEEN_ROUNDS do
&#9;&#9;&#9;Timer.Text=&quot;&quot;..math.ceil(TIME_BETWEEN_ROUNDS-(time()-startTime))
&#9;&#9;&#9;wait(0.05)
&#9;&#9;end
&#9;&#9;Timer.Text = &quot;Waiting For Server...&quot;
&#9;end
end)</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="LocalScript" referent="RBX2653">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">LeaderBoard</string>
				<ProtectedString name="Source">--------------------
--Super Util
--------------------

print(&apos;Created player list script &apos;..script.Parent.Name)

-- Generic object Create function, which I am using to create Gui&apos;s 
-- Thanks to Stravant! 
local Obj={}
function Obj.Create(guiType)
&#9;return function(data)
&#9;&#9;local obj = Instance.new(guiType)
&#9;&#9;for k, v in pairs(data) do
&#9;&#9;&#9;if type(k) == &apos;number&apos; then
&#9;&#9;&#9;&#9;v.Parent = obj
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;obj[k] = v
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;return obj
&#9;end
end 

function Obj.Clone(obj)
&#9;return function(data)
&#9;&#9;local cloneObj = obj:Clone()
&#9;&#9;for k, v in pairs(data) do 
&#9;&#9;&#9;if type(k) == &quot;number&quot; then 
&#9;&#9;&#9;&#9;v.Parent = cloneObj 
&#9;&#9;&#9;else 
&#9;&#9;&#9;&#9;cloneObj[k] = v
&#9;&#9;&#9;end
&#9;&#9;end 
&#9;&#9;return cloneObj
&#9;end
end


function MakeBackgroundGuiObj(imgName)
&#9;return Obj.Create&apos;ImageLabel&apos;
&#9;{
&#9;&#9;Name=&apos;Background&apos;,
&#9;&#9;BackgroundTransparency=1,
&#9;&#9;Image=imgName,
&#9;&#9;Position=UDim2.new(0, 0, 0, 0),
&#9;&#9;Size=UDim2.new(1,0,1,0),
&#9;}
end

function Color3I(r,g,b)
&#9;return Color3.new(r/255,g/255,b/255)
end

