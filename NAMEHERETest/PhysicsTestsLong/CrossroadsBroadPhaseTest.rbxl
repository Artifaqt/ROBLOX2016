	<Item class="TestService" referent="RBX4525">
		<Properties>
			<bool name="AutoRuns">true</bool>
			<string name="Description"></string>
			<bool name="Is30FpsThrottleEnabled">false</bool>
			<bool name="IsPhysicsEnvironmentalThrottled">false</bool>
			<bool name="IsSleepAllowed">true</bool>
			<string name="Name">TestService</string>
			<int name="NumberOfPlayers">0</int>
			<double name="Timeout">60</double>
		</Properties>
		<Item class="Script" referent="RBX4526">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<ProtectedString name="Source">local r = game:GetService(&quot;RunService&quot;)
local startTime = r.Stepped:wait()
local currentTime = startTime

local startTick = tick()

-- wait for 20 physics seconds
while (currentTime - startTime &lt; 20) do
&#9;currentTime = r.Stepped:wait()
end

local endTick = tick()
print(&quot;Took &quot;, endTick - startTick, &quot; real-time seconds to run 20 simulation seconds.&quot;)
local acceptableTime = endTick - startTick &lt; 11
script.Parent:Check(acceptableTime, &quot;Crossroads broadphase test failed to finish in a reasonable amount of time&quot;)

</ProtectedString>
			</Properties>
		</Item>
	</Item>
</namehere>