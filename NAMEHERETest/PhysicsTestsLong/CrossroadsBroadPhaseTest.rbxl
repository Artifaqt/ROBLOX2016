						<ProtectedString name="Source">function WaitForChild(parent,child)
&#9;while not parent:FindFirstChild(child) do
&#9;&#9;wait() --print(parent.Name..&quot; waiting for &quot;..child)
&#9;end
&#9;return parent[child]
end
---------------------------
--Workspace Objects
---------------------------
local Players =game.Players
local MainFrame= script.Parent
local LocalPlayer= MainFrame.Parent.Parent.Parent
local HeaderFrame=WaitForChild(MainFrame,&apos;Header&apos;)
local HeaderFrameHeight=HeaderFrame.Size.Y.Scale
local HeaderName=WaitForChild(HeaderFrame,&apos;PlayerName&apos;)
HeaderName.Text=LocalPlayer.Name
local HeaderScore=WaitForChild(HeaderFrame,&apos;PlayerScore&apos;)
local BottomFrame= WaitForChild(MainFrame,&apos;Bottom&apos;)
local ExtendButton=WaitForChild(BottomFrame,&apos;bigbutton&apos;)--&apos;extendTab&apos;)
local ExtendTab=WaitForChild(BottomFrame,&apos;extendTab&apos;)
local MaximizeButton=WaitForChild(HeaderFrame,&apos;MaximizeButton&apos;)
local ListFrame=WaitForChild(WaitForChild(MainFrame,&apos;ListFrame&apos;),&apos;SubFrame&apos;)
local MiddleTemplate=WaitForChild(MainFrame,&apos;MidTemplate&apos;)
local MiddleBGTemplate=WaitForChild(MainFrame,&apos;MidBGTemplate&apos;)
local IsMinimized=WaitForChild(MainFrame.Parent,&apos;Minimized&apos;)
local IsMaximized=WaitForChild(MainFrame.Parent,&apos;Maximized&apos;)
-------------------------
--Script objects
-------------------------
local Images =
{
&#9;bottomDark=&apos;94691904&apos;,
&#9;bottomLight=&apos;94691940&apos;,
&#9;midDark=&apos;94691980&apos;,
&#9;midLight=&apos;94692025&apos;,
}

--array of &apos;score data&apos;, each entry has:
-- Name(String)
-- Priority(number)
-- IsPrimary (bool, should it be shown in upper right)
local ScoreNames={}
local ScoreId=0

local MiddleFrames={}
local MiddleFrameBackgrounds={}
local MiddleFrameHeight=.03
--time of last click
local LastClick=0
local ButtonCooldown=.25

local MaximizedBounds=UDim2.new(.5,0,1,0)
local MaximizedPosition=UDim2.new(.25,0,.1,0)
local NormalBounds=UDim2.new(0.219999999, 0, 0.99000001, 0)
local NormalPosition=UDim2.new(0.778999984, 0, 0.0200000107, 0)
-------------------------------
--Static Functions
-------------------------------

ChatColors = {
&#9;BrickColor.new(&apos;Bright red&apos;), 
&#9;BrickColor.new(&apos;Bright orange&apos;),
&#9;BrickColor.new(&apos;Bright blue&apos;),
&#9;BrickColor.new(&apos;Earth green&apos;),
&#9;BrickColor.new(&apos;Bright violet&apos;),
&#9;BrickColor.new(&apos;Bright yellow&apos;),
&#9;BrickColor.new(&apos;Light reddish violet&apos;),
&#9;BrickColor.new(&apos;Brick yellow&apos;)
}

local function GetNameValue(pName)
&#9;local value = 0
&#9;for index = 1, #pName do 
&#9;&#9;local cValue = string.byte(string.sub(pName, index, index))
&#9;&#9;local reverseIndex = #pName - index + 1
&#9;&#9;if #pName%2 == 1 then 
&#9;&#9;&#9;reverseIndex = reverseIndex - 1&#9;&#9;&#9;
&#9;&#9;end
&#9;&#9;if reverseIndex%4 &gt;= 2 then 
&#9;&#9;&#9;cValue = -cValue &#9;&#9;&#9;
&#9;&#9;end 
&#9;&#9;value = value + cValue 
&#9;end 
&#9;return value%8
end 


function ComputeChatColor(pName)
&#9;return ChatColors[GetNameValue(pName) + 1].Color
end 

------------------------------------
--Player Entry Handling
------------------------------------

function SortFunction(a,b)
&#9;--Only the hacky-est of hacks for crossroads, prevents flipping out leaderboard
&#9;if a.Score.Value==b.Score.Value then
&#9;&#9;return a.ID.Value&lt;b.ID.Value
&#9;end
&#9;return a.Score.Value&lt;b.Score.Value
end

function InsertPlayerFrame(nplayer)
&#9;if IsMinimized.Value then
&#9;&#9;ListFrame.Position=ListFrame.Position-UDim2.new(0,0,MiddleTemplate.Size.Y.Scale,0)
&#9;end
&#9;local nFrame=MiddleTemplate:Clone()
&#9;WaitForChild(nFrame,&apos;PlayerName&apos;).Text=nplayer.Name
&#9;if nplayer.Name==LocalPlayer.Name then
&#9;&#9;HeaderScore.Text=tostring(WaitForChild(WaitForChild(nplayer,&apos;leaderstats&apos;),&apos;KOs&apos;).Value)
&#9;end
&#9;nFrame.PlayerScore.Text=tostring(WaitForChild(WaitForChild(nplayer,&apos;leaderstats&apos;),&apos;KOs&apos;).Value)
&#9;if nplayer.Name==LocalPlayer.Name then
&#9;&#9;nFrame.PlayerName.Font=&apos;ArialBold&apos;
&#9;&#9;nFrame.PlayerScore.Font=&apos;ArialBold&apos;
&#9;elseif LocalPlayer:IsFriendsWith(nplayer.userId) then
&#9;&#9;nFrame.PlayerName.TextColor3=Color3.new(251/255,253/255,116/255)--ComputeChatColor(nplayer.Name)
&#9;end

&#9;WaitForChild(nFrame,&apos;Score&apos;).Value=tostring(nplayer.leaderstats.KOs.Value)
&#9;WaitForChild(nFrame,&apos;ID&apos;).Value=nplayer.userId
&#9;nplayer.leaderstats.KOs.Changed:connect(function()
&#9;&#9;if nplayer.Name==LocalPlayer.Name then
&#9;&#9;&#9;HeaderScore.Text = tostring(nplayer.leaderstats.KOs.Value)
&#9;&#9;end
&#9;&#9;nFrame.PlayerScore.Text=tostring(nplayer.leaderstats.KOs.Value)
&#9;&#9;nFrame.Score.Value=nplayer.leaderstats.KOs.Value
&#9;end)
&#9;nFrame.Position=UDim2.new(1,0,((#MiddleFrames)*nFrame.Size.Y.Scale),0)
&#9;nFrame.Name=nplayer.Name
&#9;nFrame.Parent=ListFrame
&#9;nFrame:TweenPosition(UDim2.new(0,0,((#MiddleFrames)*nFrame.Size.Y.Scale),0), &quot;Out&quot;, &quot;Quad&quot;, .5)
&#9;table.insert(MiddleFrames,nFrame)
&#9;local middleLength=#MiddleFrames

&#9;local nBGFrame=MiddleBGTemplate:Clone()
&#9;nBGFrame.Position=UDim2.new(0,0,((#MiddleFrames-1)*nFrame.Size.Y.Scale),0)
&#9;if #MiddleFrames%2~=1 then
&#9;&#9;nBGFrame.Background.Image=&apos;http://www.namehere.com/asset/?id=&apos;..Images[&apos;midDark&apos;]
&#9;else
&#9;&#9;nBGFrame.Background.Image=&apos;http://www.namehere.com/asset/?id=&apos;..Images[&apos;midLight&apos;]
&#9;end
&#9;nBGFrame.Parent=ListFrame
&#9;table.insert(MiddleFrameBackgrounds,nBGFrame)
&#9;if not IsMinimized.Value then 
&#9;&#9;BottomFrame:TweenPosition(UDim2.new(0,0,((#MiddleFrames)*nFrame.Size.Y.Scale)+HeaderFrameHeight,0), &quot;Out&quot;, &quot;Quad&quot;, .5,true) 
&#9;end
end

---------------------------------
--Stat Handling
---------------------------------

function StatSort(a,b)
&#9;if a.Priority==b.Priority then
&#9;&#9;return a.ScoreId &lt; b.ScoreId
&#9;end
&#9;return a.Priority&lt;b.Priority
end

function StatAdded(nchild)
&#9;local nstat={}
&#9;nstat[&apos;Name&apos;]=nchild.Name
&#9;nstat[&apos;Priority&apos;]=0
&#9;if(nchild:FindFirstChild(&apos;Priority&apos;)) then
&#9;&#9;nstat[&apos;Priority&apos;]=nchild.Priority
&#9;end
&#9;nstat[&apos;IsPrimary&apos;]=true
&#9;if(nchild:FindFirstChild(&apos;IsPrimary&apos;)) then
&#9;&#9;nstat[&apos;IsPrimary&apos;]=nchild.IsPrimary
&#9;end
&#9;nstat.ScoreId=ScoreId
&#9;ScoreId=ScoreId+1
&#9;table.insert(ScoreNames,nstat)
&#9;table.sort(ScoreNames,StatSort)
end

---------------------------
--Minimizing and maximizing
---------------------------

function ToggleMinimize()
&#9;IsMinimized.Value= not IsMinimized.Value
end

function ToggleMaximize()
&#9;IsMaximized.Value= not IsMaximized.Value
&#9;
end

function UpdateMinimize()
&#9;if IsMinimized.Value then
&#9;&#9;ListFrame:TweenPosition(UDim2.new(0,0,-((#MiddleFrames)*MiddleTemplate.Size.Y.Scale),0), &quot;Out&quot;, &quot;Linear&quot;, .25,true)
&#9;&#9;BottomFrame:TweenPosition(UDim2.new(0,0,HeaderFrameHeight,0), &quot;Out&quot;, &quot;Linear&quot;, .25,true)
&#9;&#9;ExtendTab.Image=&apos;http://www.namehere.com/asset/?id=94692731&apos;
&#9;else
&#9;&#9;ListFrame:TweenPosition(UDim2.new(0,0,0,0), &quot;Out&quot;, &quot;Linear&quot;, .25,true)
&#9;&#9;BottomFrame:TweenPosition(UDim2.new(0,0,((#MiddleFrames)*MiddleTemplate.Size.Y.Scale)+HeaderFrameHeight,0), &quot;Out&quot;, &quot;Linear&quot;, .25,true)
&#9;&#9;ExtendTab.Image=&apos;http://www.namehere.com/asset/?id=94825585&apos;
&#9;end
end

function UpdateMaximize()
&#9;if(IsMaximized.Value) then
&#9;&#9;if IsMinimized.Value then
&#9;&#9;&#9;ToggleMinimize()
&#9;&#9;end
&#9;&#9;MainFrame:TweenSizeAndPosition(MaximizedBounds,MaximizedPosition)
&#9;&#9;print(&apos;Got here too!&apos;)
&#9;else
&#9;&#9;MainFrame:TweenSizeAndPosition(NormalBounds,NormalPosition)
&#9;end
end

-------------------------------
--Callback functions
-------------------------------

IsMaximized.Changed:connect(UpdateMaximize)
IsMinimized.Changed:connect(UpdateMinimize)

ExtendButton.MouseButton1Click:connect(function() 
&#9;if(time()-LastClick&lt;ButtonCooldown) then return end
&#9;LastClick=time()
&#9;ToggleMinimize()
end)

MaximizeButton.MouseButton1Click:connect(function()
&#9;if(time()-LastClick&lt;ButtonCooldown) then return end
&#9;LastClick=time()
&#9;ToggleMaximize()
end)



function PlayerAdded(nplayer)
&#9;InsertPlayerFrame(nplayer)
end


Players.ChildRemoved:connect(function(tplayer)
&#9;if IsMinimized.Value then
&#9;&#9;ListFrame.Position=ListFrame.Position+UDim2.new(0,0,MiddleTemplate.Size.Y.Scale,0)
&#9;end
&#9;for i,key in ipairs(MiddleFrames) do
&#9;&#9;--print(tplayer.Name ..&quot;==?&quot; ..key.Name)
&#9;&#9;if tplayer.Name==key.Name then
&#9;&#9;&#9;key:Destroy()
&#9;&#9;&#9;table.remove(MiddleFrames, i)
&#9;&#9;&#9;MiddleFrameBackgrounds[#MiddleFrames+1]:Destroy()
&#9;&#9;&#9;table.remove(MiddleFrameBackgrounds,#MiddleFrames+1)
&#9;&#9;&#9;if not IsMinimized.Value then
&#9;&#9;&#9;&#9;BottomFrame:TweenPosition(UDim2.new(0,0,((#MiddleFrames)*MiddleTemplate.Size.Y.Scale)+HeaderFrameHeight,0), &quot;Out&quot;, &quot;Quad&quot;, .5)
&#9;&#9;&#9;end
&#9;&#9;&#9;return --We&apos;re done here Em
&#9;&#9;end
&#9;end
end)

----------------------------
--Running Logic
----------------------------

for _,i in pairs(Players:GetPlayers()) do PlayerAdded(i) end
Players.ChildAdded:connect(PlayerAdded)

--BottomFrame.Position=UDim2.new(0,0,((#MiddleFrames-1)*MiddleTemplate.Size.Y.Scale),0)


table.sort(MiddleFrames,SortFunction)
for i,key in ipairs(MiddleFrames) do
&#9;key.Position=UDim2.new(0,0,((#MiddleFrames-(i))*key.Size.Y.Scale),0)
end

while true do
&#9;table.sort(MiddleFrames,SortFunction)
&#9;for i,key in ipairs(MiddleFrames) do
&#9;&#9;
&#9;&#9;key:TweenPosition(UDim2.new(0,0,((#MiddleFrames-(i))*key.Size.Y.Scale),0), &quot;Out&quot;, &quot;Quad&quot;, .9)
&#9;end
&#9;wait(1)
end

