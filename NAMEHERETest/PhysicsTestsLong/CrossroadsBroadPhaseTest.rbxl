				<Item class="Sound" referent="RBX2628">
					<Properties>
						<bool name="Looped">false</bool>
						<string name="Name">Boing</string>
						<float name="Pitch">1.10000002</float>
						<bool name="PlayOnRemove">false</bool>
						<Content name="SoundId"><url>http://www.namehere.com/asset/?ID=96543718</url></Content>
						<float name="Volume">0.5</float>
					</Properties>
				</Item>
				<Item class="SpecialMesh" referent="RBX2629">
					<Properties>
						<token name="LODX">2</token>
						<token name="LODY">2</token>
						<Content name="MeshId"><url>http://www.namehere.com/asset/?id=96501868</url></Content>
						<token name="MeshType">5</token>
						<string name="Name">Mesh</string>
						<Vector3 name="Offset">
							<X>0</X>
							<Y>0</Y>
							<Z>0</Z>
						</Vector3>
						<Vector3 name="Scale">
							<X>2</X>
							<Y>2</Y>
							<Z>2</Z>
						</Vector3>
						<Content name="TextureId"><url>http://www.namehere.com/asset/?id=96502130</url></Content>
						<Vector3 name="VertexColor">
