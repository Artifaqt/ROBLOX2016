		<Item class="Script" referent="RBX1814">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">RoundScript</string>
				<ProtectedString name="Source">-- Waits for parent.child to exist, then returns it
local function WaitForChild(parent, childName)
&#9;assert(parent, &quot;ERROR: WaitForChild: parent is nil&quot;)
&#9;while not parent:FindFirstChild(childName) do parent.ChildAdded:wait() end
&#9;return parent[childName]
end

local ROUND_DURATION = 30000 --5 * 60
local TIME_BETWEEN_ROUNDS = 15
local TIME_BETWEEN_REGEN = 1200

-- need to name pellets
local CLEANABLE_PARTS = {[&apos;Rocket&apos;] = true, [&apos;Cannon Shot&apos;] = true, [&apos;Bomb&apos;] = true}

local PlayersService = Game:GetService(&apos;Players&apos;)

print(&quot;round script&quot;)

local GameClock = WaitForChild(Workspace, &apos;GameClock&apos;)
local StartClock = WaitForChild(GameClock, &apos;Start&apos;)
local StopClock = WaitForChild(GameClock, &apos;Stop&apos;)
local GetSeconds = WaitForChild(GameClock, &apos;GetSeconds&apos;)
local Time = WaitForChild(GameClock, &apos;Time&apos;)

local SecondsUntilRestart = WaitForChild(script, &apos;SecondsUntilRestart&apos;)

local LastRegenTime = tick()

print(&quot;Loaded Clock&quot;)

local Leaderstats = WaitForChild(Workspace, &apos;Leaderstats&apos;)
local SetMasterStats = WaitForChild(Leaderstats, &apos;Set&apos;)

print(&quot;Loaded Stats&quot;)

local Regeneration = WaitForChild(Workspace, &apos;RegenerationScript&apos;)
local SaveModels = WaitForChild(Regeneration, &apos;SaveModels&apos;)
local BeginRegen = WaitForChild(Regeneration, &apos;BeginRegen&apos;)
local GetRegenProgress = WaitForChild(Regeneration, &apos;GetRegenProgress&apos;)
local SlowRegenerate = WaitForChild(Regeneration, &apos;SlowRegenerate&apos;)

local Spawner = WaitForChild(Workspace, &apos;Spawner&apos;)
local SpawnAllPlayers = WaitForChild(Spawner, &apos;SpawnAllPlayers&apos;)
local ClearAllPlayers = WaitForChild(Spawner, &apos;ClearAllPlayers&apos;)
local SpawnerDisable = WaitForChild(Spawner, &apos;Disable&apos;)
local SpawnerEnable = WaitForChild(Spawner, &apos;Enable&apos;)

print(&quot;Loaded Round Vars&quot;)


local function Reset()
&#9;local masterStatsTable = {}
&#9;table.insert(masterStatsTable, {Name = &quot;KOs&quot;, Value = 0})
&#9;table.insert(masterStatsTable, {Name = &quot;Wipeouts&quot;, Value = 0})
&#9;SetMasterStats:Invoke(masterStatsTable)
end

local function ResetCharacters()
&#9;for _, player in pairs(PlayersService:GetPlayers()) do
&#9;&#9;player:LoadCharacter()
&#9;end
end

local function GetNumberTrail(num)
&#9;if num==1 then
&#9;&#9;return &quot;&quot;..num..&apos;st&apos;
&#9;elseif num==2 then
&#9;&#9;return &quot;&quot;..num..&apos;nd&apos;
&#9;elseif num==3 then
&#9;&#9;return &quot;&quot;..num..&apos;rd&apos;
&#9;else
&#9;&#9;return &quot;&quot;..num..&apos;th&apos;
&#9;end
end

local function SetupPlayerWinGui(player,topPlayer,places)
&#9;if not(
&#9;&#9;&#9;player:FindFirstChild(&apos;leaderstats&apos;) and
&#9;&#9;&#9;player.leaderstats:FindFirstChild(&apos;KOs&apos;) and
&#9;&#9;&#9;topPlayer:FindFirstChild(&apos;leaderstats&apos;) and
&#9;&#9;&#9;topPlayer.leaderstats:FindFirstChild(&apos;KOs&apos;)) then
&#9;&#9;return
&#9;end
&#9;local winGui=WaitForChild(player.PlayerGui,&apos;WinGui&apos;)
&#9;local winFrame=WaitForChild(winGui,&apos;WinFrame&apos;)
&#9;WaitForChild(winFrame,&apos;PlaceName&apos;).Text=&apos;You got &apos;..GetNumberTrail(places[player])..&apos; place!&apos;
&#9;WaitForChild(winFrame,&apos;StatsText&apos;).Text=&apos;With &apos;..player.leaderstats.KOs.Value..&apos; KOs and &apos;..player.leaderstats.Wipeouts.Value..&apos; Wipeouts&apos;
&#9;WaitForChild(winFrame,&apos;MVPText&apos;).Text=&apos;The MVP was &apos;..topPlayer.Name
&#9;WaitForChild(winFrame,&apos;MVPStatsText&apos;).Text=&apos;With &apos;..topPlayer.leaderstats.KOs.Value..&apos; KOs and &apos;..topPlayer.leaderstats.Wipeouts.Value..&apos; Wipeouts&apos;
&#9;local timer=WaitForChild(winFrame,&apos;CountdownTimer&apos;)
&#9;winFrame:TweenPosition(UDim2.new(0.25, 0, 0.349999994, 0), &quot;Out&quot;, &quot;Linear&quot;, .5,true)
&#9;SecondsUntilRestart.Value = TIME_BETWEEN_ROUNDS
&#9;wait(TIME_BETWEEN_ROUNDS)
&#9;SecondsUntilRestart.Value = 0
end

local function GetTopScores()
&#9;-- Abort if no players
&#9;if PlayersService.NumPlayers &lt; 1 then
&#9;&#9;return
&#9;end

&#9;local function sortFunction(a,b)
&#9;&#9;if a[2]==b[2] then return a[1].userId&lt;b[1].userId end
&#9;&#9;return a[2]&gt;b[2]
&#9;end

&#9;local playersTable={}
&#9;local j=1
&#9;for _, player in pairs(PlayersService:GetPlayers()) do
&#9;&#9;if(player:FindFirstChild(&apos;leaderstats&apos;) and player.leaderstats:FindFirstChild(&apos;KOs&apos;)) then
&#9;&#9;&#9;playersTable[j]={player,player.leaderstats.KOs.Value}
&#9;&#9;&#9;j=j+1
&#9;&#9;end
&#9;end
&#9;table.sort(playersTable,sortFunction)

&#9;local sortedTable={}
&#9;for i,entry in ipairs(playersTable) do
&#9;&#9;sortedTable[entry[1]]=i&#9;
&#9;end
&#9;
&#9;return playersTable[1][1],sortedTable
end

local function AddTopScoresGui()
&#9;local topPlayer,places = GetTopScores()
&#9;if topPlayer and places then
&#9;&#9;for _, player in pairs(PlayersService:GetPlayers()) do
&#9;&#9;&#9;if player.PlayerGui then
&#9;&#9;&#9;&#9;Spawn(function() SetupPlayerWinGui(player,topPlayer,places) end)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

local function CleanUpLooseParts()
&#9;for _, object in pairs(Workspace:GetChildren()) do
&#9;&#9;if object:IsA(&apos;Hat&apos;) or CLEANABLE_PARTS[object.Name] then
&#9;&#9;&#9;object:Destroy()
&#9;&#9;end
&#9;end
end

-- Wait for the functions to have loaded first
wait(10)

StartClock:Invoke()
SaveModels:Invoke()

Time.Value = ROUND_DURATION
while true do&#9;
&#9;wait(1)
&#9;if GetSeconds:Invoke() &lt;= 0 then
&#9;&#9;local roundEndedTime = tick()
&#9;&#9;StopClock:Invoke()
&#9;&#9;Time.Value = ROUND_DURATION
&#9;&#9;--PlayersService.CharacterAutoLoads = false
&#9;&#9;AddTopScoresGui()
&#9;&#9;ClearAllPlayers:Invoke()
&#9;&#9;SpawnerDisable:Invoke()
&#9;&#9;wait(2)
&#9;&#9;-- cleanup rockets etc.. before spawning new buildings or they could be damaged
&#9;&#9;CleanUpLooseParts()
&#9;&#9;BeginRegen:Invoke()
&#9;&#9;
&#9;&#9;print(&apos;starting regen&apos;)
&#9;&#9;--[[
&#9;&#9;if Workspace:FindFirstChild(&apos;Message&apos;) then
&#9;&#9;&#9;Workspace.Message.Text = &quot;Regenerating&quot;
&#9;&#9;end
&#9;&#9;--]]
&#9;&#9;while GetRegenProgress:Invoke() ~= 100 do
&#9;&#9;&#9;wait(0.1)
&#9;&#9;end
&#9;&#9;--[[
&#9;&#9;if Workspace:FindFirstChild(&apos;Message&apos;) then
&#9;&#9;&#9;Workspace.Message.Text = &quot;&quot;
&#9;&#9;end
&#9;&#9;--]]
&#9;&#9;print(&apos;ending regen&apos;)
&#9;&#9;wait(math.max(0, TIME_BETWEEN_ROUNDS - (tick() - roundEndedTime)))
&#9;&#9;SpawnerEnable:Invoke()
&#9;&#9;--SpawnAllPlayers:Invoke()
&#9;&#9;--wait(2)
&#9;&#9;--PlayersService.CharacterAutoLoads = true
&#9;&#9;Reset()
&#9;&#9;--wait(1)
&#9;&#9;Time.Value = ROUND_DURATION
&#9;&#9;StartClock:Invoke()
&#9;--[[ Make sure that we aren&apos;t going to be regening on top of our round reset regeneration
&#9;elseif tick() - LastRegenTime &gt; TIME_BETWEEN_REGEN and TIME_BETWEEN_REGEN * 1.1 &lt; GetSeconds:Invoke() then
&#9;&#9;SlowRegenerate:Invoke(TIME_BETWEEN_REGEN - 10)
&#9;&#9;LastRegenTime = tick()
&#9;--]]
&#9;end
end
</ProtectedString>
