				</Properties>
			</Item>
		</Item>
		<Item class="Script" referent="RBX17">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">RegenerationScript</string>
				<ProtectedString name="Source">--------------------
--| WaitForChild |--
--------------------

-- Waits for parent.child to exist, then returns it
local function WaitForChild(parent, childName)
&#9;assert(parent, &quot;ERROR: WaitForChild: parent is nil&quot;)
&#9;while not parent:FindFirstChild(childName) do parent.ChildAdded:wait() end
&#9;return parent[childName]
end

-----------------
--| Variables |--
-----------------

local LightingService = Game:GetService(&apos;Lighting&apos;) --TODO: Use new data storage service when it exists
local PlayersService = Game:GetService(&apos;Players&apos;)

local SaveModels = WaitForChild(script, &apos;SaveModels&apos;)
local ClearModels = WaitForChild(script, &apos;ClearModels&apos;)
local BeginRegen = WaitForChild(script, &apos;BeginRegen&apos;)
local GetRegenProgress = WaitForChild(script, &apos;GetRegenProgress&apos;)
local SlowRegenerate = WaitForChild(script, &apos;SlowRegenerate&apos;)

local ToBeRegenerated = LightingService:FindFirstChild(&apos;ToBeRegenerated&apos;)
if not ToBeRegenerated then
&#9;ToBeRegenerated = Instance.new(&apos;Model&apos;, LightingService)
&#9;ToBeRegenerated.Name = &quot;ToBeRegenerated&quot;
end

local RegenProgress = 0

-------------------------
--| Utility Functions |--
-------------------------

-- Destroys all archivable Models in the Workspace
local function DestroyModels()
&#9;for _, child in pairs(Workspace:GetChildren()) do
&#9;&#9;if child and child.Parent == Workspace and child:IsA(&apos;Model&apos;) then
&#9;&#9;&#9;if child.Archivable then
&#9;&#9;&#9;&#9;child:Destroy()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

local function PrintFullHierarchy(object)
&#9;local result = &quot;&quot;
&#9;if object then
&#9;&#9;result = object.Name
&#9;&#9;local parent = object.Parent
&#9;&#9;while parent do
&#9;&#9;&#9;result = parent.Name .. &quot;.&quot; .. result
&#9;&#9;&#9;parent = parent.Parent
&#9;&#9;end
&#9;end
&#9;return result
end

local function RecursivelyAnchorModelHelper(model, anchorTable)
&#9;if model == nil then return end

&#9;&#9;&#9;
&#9;if model:IsA(&apos;BasePart&apos;) then
&#9;&#9;if not model.Anchored then
&#9;&#9;&#9;model.Anchored = true
&#9;&#9;&#9;--print(child.Name , &quot;is now anchored&quot; , child.Anchored)
&#9;&#9;&#9;table.insert(anchorTable, model)
&#9;&#9;end
&#9;--else
&#9;&#9;--print(&quot;Not anchoring:&quot; , PrintFullHierarchy(model) , &quot;because not a part&quot;)
&#9;end

&#9;for _, child in pairs(model:GetChildren()) do

&#9;
&#9;&#9;RecursivelyAnchorModelHelper(child, anchorTable)
&#9;end
end

local function RecursivelyAnchorModel(model)
&#9;local anchorTable = {}
&#9;RecursivelyAnchorModelHelper(model, anchorTable)
&#9;return anchorTable
end

local function RestoreAnchorProperties(anchorTable)
&#9;for _, part in pairs(anchorTable) do
&#9;&#9;if part then
&#9;&#9;&#9;--print(&apos;Unanchoring&apos; , part.Name)
&#9;&#9;&#9;part.Anchored = false
&#9;&#9;end
&#9;end
end

local function RegenerateModel(model)
&#9;local clone = model:Clone()
&#9;print(&quot;Anchoring:&quot; , model.Name)
&#9;local anchorTable = RecursivelyAnchorModel(model)
&#9;clone.Parent = Workspace
&#9;clone:MakeJoints()
&#9;--RecursivelyAnchorModel(model)
&#9;return anchorTable
end

-- Regenerates the Models saved in ToBeRegenerated, updating RegenProgress along the way
local function Regenerate()
&#9;local anchoredModelsTable = {}
&#9;RegenProgress = 0
&#9;DestroyModels()
&#9;wait(1)
&#9;local regenList = ToBeRegenerated:GetChildren()
&#9;table.sort(regenList, function(a, b) return a.Name &lt; b.Name end)
&#9;for i, model in pairs(regenList) do
&#9;&#9;local timeStarted = tick()
&#9;&#9;local anchorTable = RegenerateModel(model)
&#9;&#9;table.insert(anchoredModelsTable, anchorTable)
&#9;&#9;RegenProgress = math.max(0, math.floor((i / #regenList) * 100) - 1) -- (Percent complete)
&#9;&#9;--wait(0.1)
&#9;end
&#9;print(&quot;Anchoring done starting unanchoring&quot;)
&#9;wait(3)
&#9;for _, anchorTable in pairs(anchoredModelsTable) do
&#9;&#9;RestoreAnchorProperties(anchorTable)
&#9;end
&#9;RegenProgress = 100 
end

--------------------------
--| Bindable Functions |--
--------------------------

-- SaveModels: Saves a copy of all archivable Models in the Workspace into ToBeRegenerated
SaveModels.OnInvoke = function()
&#9;print(&quot;Saved model called&quot; , tick())
&#9;ToBeRegenerated:ClearAllChildren()
&#9;for _, child in pairs(Workspace:GetChildren()) do
&#9;&#9;if child and child.Parent == Workspace and child:IsA(&apos;Model&apos;) and child.Archivable then
&#9;&#9;&#9;local clone = child:Clone()
&#9;&#9;&#9;clone.Parent = ToBeRegenerated
&#9;&#9;end
&#9;end
end

-- ClearModels: [See DestroyModels]
ClearModels.OnInvoke = DestroyModels

-- BeginRegen: [See Regenerate]
BeginRegen.OnInvoke = function()
&#9;Spawn(Regenerate) --NOTE: We use Spawn here because callbacks cannot yield
end

-- GetRegenProgress: Returns the regeneration percent complete
GetRegenProgress.OnInvoke = function()
&#9;return RegenProgress
end

SlowRegenerate.OnInvoke = function(secondsToRegenIn)
&#9;Spawn(function()
&#9;&#9;local regenList = ToBeRegenerated:GetChildren()
&#9;&#9;table.sort(regenList, function(a, b) return a.Name &lt; b.Name end)
&#9;&#9;local secondsBetweenRegens = math.max(0, secondsToRegenIn / #regenList)
&#9;&#9;for i, model in pairs(regenList) do
&#9;&#9;&#9;local modelToDestroy = Workspace:FindFirstChild(model.Name)
&#9;&#9;&#9;if modelToDestroy then
&#9;&#9;&#9;&#9;modelToDestroy:Destroy()
&#9;&#9;&#9;end
&#9;&#9;&#9;RestoreAnchorProperties(RegenerateModel(model))
&#9;&#9;&#9;-- Could regenerate trees everytime
&#9;&#9;&#9;wait(secondsBetweenRegens)
&#9;&#9;end
&#9;end)
end
</ProtectedString>
