				<ProtectedString name="Source">print &apos;Admin Console 1.0 Loaded&apos;

function incomingMessage(msg)
&#9;if string.sub(msg.Name, 1, 4) == &quot;ping&quot; then
&#9;&#9;msg.Value = 1
