		<Item class="ScreenGui" referent="RBX2654">
			<Properties>
				<string name="Name">KillFeedGui</string>
			</Properties>
			<Item class="Frame" referent="RBX2655">
				<Properties>
					<bool name="Active">false</bool>
					<Color3 name="BackgroundColor3">4288914085</Color3>
					<float name="BackgroundTransparency">1</float>
					<Color3 name="BorderColor3">4279970357</Color3>
					<int name="BorderSizePixel">1</int>
					<bool name="ClipsDescendants">false</bool>
					<bool name="Draggable">false</bool>
					<string name="Name">KillFeedFrame</string>
					<UDim2 name="Position">
						<XS>0</XS>
						<XO>0</XO>
						<YS>0.400000036</YS>
						<YO>-22</YO>
					</UDim2>
					<UDim2 name="Size">
						<XS>0</XS>
						<XO>500</XO>
						<YS>0</YS>
						<YO>150</YO>
					</UDim2>
					<token name="SizeConstraint">0</token>
					<token name="Style">0</token>
					<bool name="Visible">true</bool>
					<int name="ZIndex">1</int>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX2656">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">KillFeedGuiScript</string>
					<ProtectedString name="Source">-----------------
--| Constants |--
-----------------

local DELIMITER = &apos;#&apos; -- Separates words (NOTE: Custom input text must not contain this)
local NOGAP_TAG = &apos;_&apos; -- Placed at the front of a custom word, this will remove the gap between this and the last word
--NOTE: These must match up with the MainScript (KillFeed)

local LABEL_GAP = 5
local DISPLAY_DURATION = 7
local VERTICAL_SCALE_AMOUNT = 0.55
local TWEEN_DURATION = 0.75
local NEW_ELEMENT_VERTICAL_SCALE = 0.90

--------------------
--| WaitForChild |--
--------------------

-- Waits for parent.child to exist, then returns it
local function WaitForChild(parent, childName)
&#9;assert(parent, &quot;ERROR: WaitForChild: parent is nil&quot;)
&#9;while not parent:FindFirstChild(childName) do parent.ChildAdded:wait() end
&#9;return parent[childName]
end

-----------------
--| Variables |--
-----------------

local DebrisService = Game:GetService(&apos;Debris&apos;)

local KillFeedGui = script.Parent
local KillFeedFrame = WaitForChild(KillFeedGui, &apos;KillFeedFrame&apos;)

local Events = {}

local Scrolling  = false
local Initalized = false

local TextLabelBase = Instance.new(&apos;TextLabel&apos;) do
&#9;TextLabelBase.BackgroundTransparency = 1.0
&#9;TextLabelBase.Font = Enum.Font.ArialBold
&#9;TextLabelBase.TextColor3=Color3.new(0,0,0)
&#9;TextLabelBase.FontSize = Enum.FontSize.Size24
&#9;TextLabelBase.TextStrokeColor3=Color3.new(1,1,1)
&#9;TextLabelBase.TextStrokeTransparency=0
end

local ImageLabelBase = Instance.new(&apos;ImageLabel&apos;) do
&#9;ImageLabelBase.BackgroundTransparency = 1.0
&#9;ImageLabelBase.Size = UDim2.new(0, 50, 0, 50)
end

-----------------
--| Functions |--
-----------------


function FadeOut(tframe,aliveTime)
&#9;--[[
&#9;local start=time()
&#9;while time()-start&lt;aliveTime do
&#9;&#9;local nalpha= (time()-start)/aliveTime
&#9;&#9;for _,i in pairs(tframe:GetChildren()) do
&#9;&#9;&#9;if i:IsA(&apos;TextLabel&apos;) then
&#9;&#9;&#9;&#9;i.TextTransparency=nalpha
&#9;&#9;&#9;&#9;i.TextStrokeTransparency=nalpha
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;wait(1/30)
&#9;end
&#9;--]]
&#9;tframe:TweenPosition(UDim2.new(-.5, 0, tframe.Position.Y.Scale,tframe.Position.Y.Offset), &quot;Out&quot;, &quot;Quad&quot;, aliveTime, true)
end

function KillFeedChildAdded(child)
&#9;if not child:IsA(&apos;StringValue&apos;) then return end

&#9;-- Read in the input string and separate it into words
&#9;local inputWords = {}
&#9;for word in child.Value:gmatch(&apos;[^&apos; .. DELIMITER ..&apos;]+&apos;) do
&#9;&#9;table.insert(inputWords, word)
&#9;end

&#9;-- Wait for scrolling (within other calls) to finish
&#9;while Scrolling do
&#9;&#9;wait()
&#9;end

&#9;-- Scroll existing events up a level to make room for the new event
&#9;Scrolling  = true
&#9;local tweenTime = TWEEN_DURATION
&#9;if not Initalized then tweenTime = 0.10 end
&#9;for _, event in pairs(Events) do
&#9;&#9;if event then
&#9;&#9;&#9;for _, field in pairs(event) do
&#9;&#9;&#9;&#9;if field and field.Parent then
&#9;&#9;&#9;&#9;&#9;field:TweenPosition(field.Position + UDim2.new(0, 0, -VERTICAL_SCALE_AMOUNT, 0), &quot;Out&quot;, &quot;Quad&quot;, tweenTime, true)
&#9;&#9;&#9;&#9;&#9;if field.Position.Y.Scale &lt; -VERTICAL_SCALE_AMOUNT then
&#9;&#9;&#9;&#9;&#9;&#9;field:Destroy()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;wait(tweenTime)
&#9;Scrolling  = false


&#9;local tframe=Instance.new(&apos;Frame&apos;)
&#9;
&#9;tframe.Size=UDim2.new(0, 500, 0, 50)
&#9;tframe.BackgroundTransparency=1
&#9;tframe.Parent=KillFeedFrame
&#9;tframe.Position= UDim2.new(-1, 0, NEW_ELEMENT_VERTICAL_SCALE, 0 - (tframe.Size.Y.Offset / 2))

&#9;-- Create and place all the elements that make up the event line
&#9;local eventLine = {}
&#9;do
&#9;&#9;
&#9;&#9;local lastElement = nil
&#9;&#9;for _, word in pairs(inputWords) do
&#9;&#9;&#9;if word then
&#9;&#9;&#9;&#9;-- Try word as a color (formatted like this: [1032])
&#9;&#9;&#9;&#9;local colorCode = tonumber(word:gsub(&apos;%[(%d+)%]&apos;, &apos;%1&apos;, 1), nil)
&#9;&#9;&#9;&#9;if colorCode and lastElement then
&#9;&#9;&#9;&#9;&#9;lastElement.TextColor3 = BrickColor.new(colorCode).Color
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;local element = nil
&#9;&#9;&#9;&#9;&#9;local addGap = true
&#9;&#9;&#9;&#9;&#9;if word:find(&apos;://&apos;) then -- Word is content, use as image
&#9;&#9;&#9;&#9;&#9;&#9;element = ImageLabelBase:Clone()
&#9;&#9;&#9;&#9;&#9;&#9;element.Image = word
&#9;&#9;&#9;&#9;&#9;&#9;element.Parent = tframe
&#9;&#9;&#9;&#9;&#9;else -- Word is just a string
&#9;&#9;&#9;&#9;&#9;&#9;element = TextLabelBase:Clone()
&#9;&#9;&#9;&#9;&#9;&#9;local text, n = word:gsub(&apos;^&apos; .. NOGAP_TAG, &apos;&apos;, 1) -- Check for and remove the NOGAP_TAG
&#9;&#9;&#9;&#9;&#9;&#9;if n == 1 then addGap = false end -- If it was there, don&apos;t add a LABEL_GAP later
&#9;&#9;&#9;&#9;&#9;&#9;element.Text = text
&#9;&#9;&#9;&#9;&#9;&#9;element.Parent = tframe  --NOTE: This must be done before we can use TextBounds
&#9;&#9;&#9;&#9;&#9;&#9;element.Size = UDim2.new(0, math.ceil(element.TextBounds.x), 0, math.ceil(element.TextBounds.y))
&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;DebrisService:AddItem(element, DISPLAY_DURATION)
&#9;&#9;&#9;&#9;&#9;local xOffset = lastElement and lastElement.Position.X.Offset + lastElement.Size.X.Offset + (addGap and LABEL_GAP or 0) or 0
&#9;&#9;&#9;&#9;&#9;element.Position = UDim2.new(0, xOffset, NEW_ELEMENT_VERTICAL_SCALE, 0 - (element.Size.Y.Offset / 2))
&#9;&#9;&#9;&#9;&#9;table.insert(eventLine, element)
&#9;&#9;&#9;&#9;&#9;lastElement = element
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end --end while loop
&#9;&#9;&#9;tframe:TweenPosition(UDim2.new(0, 20, NEW_ELEMENT_VERTICAL_SCALE, 0 - (tframe.Size.Y.Offset / 2)), &quot;Out&quot;, &quot;Quad&quot;, tweenTime, true)
&#9;&#9;&#9;DebrisService:AddItem(tframe, DISPLAY_DURATION)
&#9;&#9;&#9;Spawn(function() wait(3) FadeOut(tframe,2) end)
&#9;&#9;end
&#9;end
&#9;table.insert(Events, eventLine) -- Save the event so we can scroll it later
end

--------------------
--| Script Logic |--
--------------------

-- Connect to ChildAdded for all future events
script.Parent.ChildAdded:connect(KillFeedChildAdded)

Initalized = true
</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="ScreenGui" referent="RBX2657">
			<Properties>
				<string name="Name">FireButtonGui</string>
			</Properties>
			<Item class="LocalScript" referent="RBX2658">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">FireButtonGuiScript</string>
					<ProtectedString name="Source">-- Checking for iPad --

local status, error = pcall(function() Game:GetService(&apos;UserInputService&apos;) end)
if not status then print(&quot;ERROR:&quot;, error) return end
--TODO: This works for now but must be updated before UserInputService is available on PC

-- Constants --

local TOOL_BOOLVALUE_NAME = &apos;FireButtonDown&apos; --NOTE: Changing this requires changing all Tools

local ICON_SUBSTITUTION_TABLE = {Sword = &apos;http://www.namehere.com/asset/?id=96601703&apos;}

-- WaitForChild --

-- Waits for parent.child to exist, then returns it
local function WaitForChild(parent, childName)
&#9;assert(parent, &quot;ERROR: WaitForChild: parent is nil&quot;)
&#9;while not parent:FindFirstChild(childName) do parent.ChildAdded:wait() end
&#9;return parent[childName]
end

-- Variables --

local FireButtonGui = script.Parent
local FireButtonFrame = WaitForChild(FireButtonGui, &apos;FireButtonFrame&apos;)
local FireButton = WaitForChild(FireButtonFrame, &apos;FireButton&apos;)
local FireButtonCopy = WaitForChild(FireButtonFrame, &apos;FireButtonCopy&apos;)
local ToolIcon = WaitForChild(FireButtonFrame, &apos;ToolIcon&apos;)

local PlayerGui = FireButtonGui.Parent
local Player = PlayerGui.Parent
local Backpack = WaitForChild(Player, &apos;Backpack&apos;)

local Down = false

-- Functions --

local function FindEquippedTool(character)
&#9;for _, child in pairs(character:GetChildren()) do
&#9;&#9;if child:IsA(&apos;Tool&apos;) then
&#9;&#9;&#9;return child
&#9;&#9;end
&#9;end
end

local function SendSignalToTool(bool)
&#9;if Player.Character then
&#9;&#9;local equippedTool = FindEquippedTool(Player.Character)
&#9;&#9;if equippedTool then
&#9;&#9;&#9;local buttonDownObject = equippedTool:FindFirstChild(TOOL_BOOLVALUE_NAME)
&#9;&#9;&#9;if buttonDownObject then
&#9;&#9;&#9;&#9;buttonDownObject.Value = bool
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

local function OnMouseButton1Down()
&#9;print(&quot;FireButton Down&quot;)
&#9;Down = true
&#9;FireButtonCopy.Visible = true
&#9;SendSignalToTool(true) -- Send &apos;down&apos; signal to Tool
end

local function OnMouseButton1Up()
&#9;print(&quot;FireButton Up&quot;)
&#9;Down = false
&#9;FireButtonCopy.Visible = false
&#9;SendSignalToTool(false) -- Send &apos;up&apos; signal to Tool
end

local function OnMouseEnter()
&#9;print(&quot;FireButton Enter&quot;)
&#9;if Down then
&#9;&#9;FireButtonCopy.Visible = true
&#9;end
end

local function OnMouseLeave()
&#9;print(&quot;FireButton Leave&quot;)
&#9;if Down then
&#9;&#9;FireButtonCopy.Visible = false
&#9;end
end

-- Fires when a Tool is unequipped
local function OnBackpackChildAdded(child)
&#9;print(&quot;&gt;&gt;&gt;FireButton BackpackChildAdded (UNEQUIP):&quot;, child)
&#9;if child:IsA(&apos;Tool&apos;) then
&#9;&#9;ToolIcon.Image = &apos;&apos; -- Remove any icon

&#9;&#9;-- Remove buttonDownObject from Tool
&#9;&#9;local buttonDownObject = child:FindFirstChild(TOOL_BOOLVALUE_NAME)
&#9;&#9;if buttonDownObject then
&#9;&#9;&#9;buttonDownObject:Destroy()
&#9;&#9;end
&#9;end
end

-- Fires when a Tool is equipped
local function OnBackpackChildRemoved(child)
&#9;print(&quot;&gt;&gt;&gt;FireButton BackpackChildRemoved (EQUIP):&quot;, child)
&#9;if child:IsA(&apos;Tool&apos;) then
&#9;&#9;-- Update icon
&#9;&#9;local substituteIcon = ICON_SUBSTITUTION_TABLE[child.Name]
&#9;&#9;if not substituteIcon then
&#9;&#9;&#9;ToolIcon.Image = child.TextureId
&#9;&#9;else
&#9;&#9;&#9;ToolIcon.Image = substituteIcon
&#9;&#9;end

&#9;&#9;-- Add buttonDownObject to Tool
&#9;&#9;local buttonDownObject = Instance.new(&apos;BoolValue&apos;)
&#9;&#9;buttonDownObject.Name = TOOL_BOOLVALUE_NAME
&#9;&#9;buttonDownObject.Parent = child
&#9;end
end

-- Script Logic --

FireButton.MouseButton1Down:connect(OnMouseButton1Down)
FireButton.MouseButton1Up:connect(OnMouseButton1Up) --NOTE: &apos;Up&apos; currently does not fire if you let go when not above the element
FireButton.MouseEnter:connect(OnMouseEnter) --NOTE: &apos;Enter&apos; currently fires an additional time on any mouse activity after an &apos;Up&apos;
FireButton.MouseLeave:connect(OnMouseLeave)
Backpack.ChildAdded:connect(OnBackpackChildAdded)
Backpack.ChildRemoved:connect(OnBackpackChildRemoved)
FireButtonFrame.Visible = true
</ProtectedString>
				</Properties>
